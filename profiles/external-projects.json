    {
      "name": "retroarch",
      "display_name": "RetroArch",
      "directory": "RetroArch",
      "primary_remote": "rjwittams",
      "checkout": "macos-sdl2-window-contexts",
      "remotes": {
        "origin": "https://github.com/libretro/RetroArch.git",
        "rjwittams": "https://github.com/rjwittams/RetroArch.git"
      },
      "profiles": [
        "sonic",
        "mmx",
        "rrds",
        "jsr",
        "spyro"
      ],
      "build": {
        "macos": [
          "./configure --enable-sdl2 --disable-metal",
          "make -j$(sysctl -n hw.ncpu)"
        ],
        "linux": [
          "./configure --enable-sdl2",
          "make -j$(nproc)"
        ]
      },
      "doctor": {
        "tools": [
          "make"
        ],
        "pkg_config": [
          "sdl2"
        ],
        "paths": [
          {
            "kind": "output",
            "path": "retroarch"
          }
        ],
        "assets": [
          {
            "label": "RetroArch Genesis Plus GX core",
            "platforms": [
              "macos"
            ],
            "path": "$HOME/Library/Application Support/RetroArch/cores/genesis_plus_gx_libretro.dylib"
          },
          {
            "label": "RetroArch melonDS core",
            "platforms": [
              "macos"
            ],
            "path": "$HOME/Library/Application Support/RetroArch/cores/melonds_libretro.dylib"
          },
          {
            "label": "RetroArch bsnes core",
            "platforms": [
              "macos"
            ],
            "path": "$HOME/Library/Application Support/RetroArch/cores/bsnes_libretro.dylib"
          },
          {
            "label": "RetroArch Flycast core",
            "platforms": [
              "macos"
            ],
            "path": "$HOME/Library/Application Support/RetroArch/cores/flycast_libretro.dylib"
          },
          {
            "label": "RetroArch Genesis Plus GX core; download 'Sega - MS/GG/MD/CD (Genesis Plus GX)' from Online Updater > Core Downloader, or configure RetroArch to use Arch package libretro-genesis-plus-gx",
            "platforms": [
              "linux"
            ],
            "any_of": [
              "$HOME/.config/retroarch/cores/genesis_plus_gx_libretro.so",
              "$HOME/.local/share/libretro/cores/genesis_plus_gx_libretro.so",
              "/usr/lib/libretro/genesis_plus_gx_libretro.so"
            ]
          },
          {
            "label": "RetroArch melonDS core; download 'Nintendo - DS (melonDS)' from Online Updater > Core Downloader, or configure RetroArch to use Arch package libretro-melonds",
            "platforms": [
              "linux"
            ],
            "elf_no_execstack": true,
            "any_of": [
              "$HOME/.config/retroarch/cores/melonds_libretro.so",
              "$HOME/.local/share/libretro/cores/melonds_libretro.so",
              "/usr/lib/libretro/melonds_libretro.so"
            ]
          },
          {
            "label": "RetroArch bsnes core; download 'Nintendo - SNES / SFC (bsnes)' from Online Updater > Core Downloader, or configure RetroArch to use Arch package libretro-bsnes",
            "platforms": [
              "linux"
            ],
            "any_of": [
              "$HOME/.config/retroarch/cores/bsnes_libretro.so",
              "$HOME/.local/share/libretro/cores/bsnes_libretro.so",
              "/usr/lib/libretro/bsnes_libretro.so"
            ]
          },
          {
            "label": "RetroArch Flycast core; download 'Sega - Dreamcast/Naomi (Flycast)' from Online Updater > Core Downloader, or configure RetroArch to use Arch package libretro-flycast",
            "platforms": [
              "linux"
            ],
            "any_of": [
              "$HOME/.config/retroarch/cores/flycast_libretro.so",
              "$HOME/.local/share/libretro/cores/flycast_libretro.so",
              "/usr/lib/libretro/flycast_libretro.so"
            ]
          },
          {
            "path": "$HOME/roms/sonic.md"
          },
          {
            "path": "$HOME/roms/mmx.sfc"
          },
          {
            "path": "$HOME/roms/rrds.nds"
          },
          {
            "path": "$HOME/roms/jgr/jgr.cue"
          },
          {
            "path": "$HOME/roms/spyro/spyro.cue"
          }
        ]
      },
      "notes": [
        "Pushed branch includes macOS SDL2 video/input enablement, Cocoa bootstrap suppression, SDL-owned GL windows, and SDL Vulkan context work.",
        "After first run, use RetroArch's Online Updater to fetch Core Info Files, Controller Profiles, Assets, Databases, and any shader packages needed by selected cores; these live in user-configurable RetroArch directories and are not currently doctor-checked.",
        "Linux should still validate which pieces are portable before treating this branch as upstreamable there."
      ]
    },
