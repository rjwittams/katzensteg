    {
      "name": "scummvm",
      "display_name": "ScummVM",
      "directory": "scummvm",
      "primary_remote": "origin",
      "checkout": "master",
      "remotes": {
        "origin": "https://github.com/scummvm/scummvm.git",
        "rjwittams": "https://github.com/rjwittams/scummvm.git"
      },
      "profiles": [
        "mi2",
        "scummvm.launcher",
        "bass"
      ],
      "build": {
        "macos": [
          "./configure",
          "make -j$(sysctl -n hw.ncpu)"
        ],
        "linux": [
          "./configure",
          "make -j$(nproc)"
        ],
        "windows": [
          "cmake -S devtools/create_project/cmake -B dists/msvc/create_project-build -G Ninja -DCMAKE_BUILD_TYPE=Release",
          "cmake --build dists/msvc/create_project-build",
          "cd dists\\msvc && create_project-build\\create_project.exe ..\\.. --msvc --msvc-version 17 --sdl2 --libs-path %SDL2% --disable-all-engines --enable-engine=sky,queen --disable-detection-full --disable-zlib --disable-mad --disable-fribidi --disable-ogg --disable-vorbis --disable-flac --disable-png --disable-mpeg2 --disable-theoradec --disable-freetype2 --disable-jpeg --disable-fluidsynth --disable-libcurl --disable-sdlnet --disable-nasm --disable-http --disable-basic-net --disable-cloud --disable-enet --disable-tts --disable-printing --disable-bink --disable-3d --disable-opengl --disable-opengl_game_classic --disable-opengl_game_shaders --disable-tinygl --disable-mt32emu --disable-translation --disable-taskbar",
          "msbuild dists\\msvc\\scummvm.sln /m /p:Configuration=Release /p:Platform=x64",
          "copy /y %SDL2%\\lib\\x64\\SDL2.dll dists\\msvc\\Releasex64\\"
        ]
      },
      "doctor": {
        "tools": [
          {
            "name": "make",
            "platforms": [
              "linux",
              "macos"
            ]
          },
          {
            "name": "msbuild",
            "platforms": [
              "windows"
            ]
          },
          {
            "name": "cmake",
            "platforms": [
              "windows"
            ]
          }
        ],
        "pkg_config": [
          {
            "name": "sdl2",
            "platforms": [
              "linux",
              "macos"
            ]
          }
        ],
        "paths": [
          {
            "kind": "output",
            "path": "scummvm",
            "platforms": [
              "linux",
              "macos"
            ]
          },
          {
            "kind": "output",
            "path": "dists/msvc/Releasex64/scummvm.exe",
            "platforms": [
              "windows"
            ]
          },
          {
            "kind": "output",
            "path": "dists/msvc/Releasex64/SDL2.dll",
            "platforms": [
              "windows"
            ]
          }
        ],
        "assets": [
          {
            "path": "$HOME/roms/mi2"
          },
          {
            "label": "Beneath a Steel Sky (freeware from scummvm.org/games)",
            "path": "$HOME/roms/bass/sky.dsk"
          }
        ]
      },
      "notes": [
        "No app-side Katzensteg patch is currently required.",
        "Windows: build from an x64 Visual Studio developer prompt with SDL2 set to the SDL2 Visual C++ development package. create_project generates the MSBuild solution in dists/msvc; the listed options build only the freeware-game engines (sky, queen) without optional libraries. Windows builds link the official SDL2.dll through the Visual C++ development package's import library and copy SDL2.dll beside the executable; SDL_DYNAMIC_API cannot reach a statically linked SDL.",
        "The bass profile runs the freeware Beneath a Steel Sky from $HOME/roms/bass; scummvm.launcher shows the launcher without game data."
      ]
    },
