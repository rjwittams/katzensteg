        ],
        "linux": [
          "cmake -S . -B build",
          "cmake --build build"
        ]
      },
      "doctor": {
        "tools": [
          "cmake"
        ],
        "pkg_config": [],
        "paths": [
          {
            "kind": "output",
            "path": "build"
          }
        ],
        "assets": []
      },
      "notes": [
        "Tracked as a Chiaki submodule branch; not cloned by default as a top-level checkout."
      ]
    },
    {
      "name": "anese",
      "display_name": "ANESE",
      "directory": "ANESE",
      "primary_remote": "origin",
      "checkout": "master",
