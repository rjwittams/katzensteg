{
  "profiles": {
    "app.input_probe": {
      "hidden": true,
      "target": "{repo}/zig-out/bin/katzensteg-input-probe",
      "args": [
        "--log-events"
      ]
    },
    "app.input_probe_sdl3": {
      "hidden": true,
      "target": "{repo}/zig-out/bin/katzensteg-input-probe-sdl3",
      "args": [
        "--log-events"
      ]
    },
    "probe.input": {
      "extends": [
        "app.input_probe",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ]
    },
    "probe.input.cursor": {
      "extends": [
        "app.input_probe",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ],
      "args": [
        "--log-events",
        "--custom-cursor"
      ]
    },
    "probe.input.sdl3": {
      "extends": [
        "app.input_probe_sdl3",
        "adapter.sdl3_preload",
        "runtime.fullscreen_file"
      ]
    },
    "probe.input.sdl3.cursor": {
      "extends": [
        "app.input_probe_sdl3",
        "adapter.sdl3_preload",
        "runtime.fullscreen_file"
      ],
      "args": [
        "--log-events",
        "--custom-cursor"
      ]
    },
    "probe.embed.basic_sdl": {
      "hidden": true,
      "extends": [
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ],
      "target": "{repo}/zig-out/bin/basic-sdl-demo"
    },
    "probe.embed.basic_sdl3": {
      "hidden": true,
      "extends": [
        "adapter.sdl3_preload",
        "runtime.fullscreen_file"
      ],
      "target": "{repo}/zig-out/bin/basic-sdl3-demo"
    },
    "app.gl_probe": {
      "hidden": true,
      "target": "{repo}/zig-out/bin/katzensteg-gl-probe"
    },
    "app.gl_probe_sdl3": {
      "hidden": true,
      "target": "{repo}/zig-out/bin/katzensteg-gl-probe-sdl3"
    },
    "probe.gl": {
      "extends": [
        "app.gl_probe",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ]
    },
    "probe.gl.sdl3": {
      "extends": [
        "app.gl_probe_sdl3",
        "adapter.sdl3_preload",
        "runtime.fullscreen_file"
      ]
    },
    "app.codexbar_sdl": {
      "hidden": true,
      "target": "{home}/dev/CodexBar/.build/debug/CodexBarSDL"
    },
    "probe.codexbar_sdl": {
      "extends": [
        "app.codexbar_sdl",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ]
    },
    "probe.embed.luchs_static": {
      "hidden": true,
      "extends": [
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ],
      "target": "{repo}/zig-out/bin/luchs",
      "args": [
        {
          "macos": "--renderer=native-webview"
        },
        "--frames=180",
        "{repo}/tools/luchs/testdata/static.html"
      ]
    },
    "probe.embed.luchs_interactive": {
      "extends": [
        "adapter.sdl2_preload",
        "runtime.fullscreen_file"
      ],
      "target": "{repo}/zig-out/bin/luchs",
      "args": [
        {
          "macos": "--renderer=native-webview"
        },
        "{repo}/tools/luchs/testdata/interactive.html"
      ]
    },
    "app.vulkan_probe": {
      "hidden": true,
      "target": "{repo}/zig-out/bin/katzensteg-vulkan-probe"
    },
    "app.vulkan_probe_sdl3": {
      "hidden": true,
      "target": "{repo}/zig-out/bin/katzensteg-vulkan-probe-sdl3"
    },
    "app.gamescope": {
      "hidden": true,
      "target": "$HOME/dev/gamescope/build-sdl/src/gamescope",
      "args": [
        "--backend",
        "sdl",
        "-W",
        "640",
        "-H",
        "360",
        "-w",
        "640",
        "-h",
        "360",
        "--",
        "vkcube",
        "--wsi",
        "xcb"
      ],
      "env": {
        "PATH": "$HOME/dev/gamescope/build-sdl/src:$PATH",
        "ENABLE_GAMESCOPE_WSI": "1",
        "VK_LAYER_PATH": {
          "linux": "{repo}/profiles/vulkan/linux:/tmp/katzensteg-vulkan-layers",
          "macos": "{repo}/profiles/vulkan/macos:/tmp/katzensteg-vulkan-layers"
        },
        "KATZENSTEG_TRACE_VULKAN": "1",
        "KATZENSTEG_TRACE_SDL": "1"
      },
      "seed_files": [
        {
          "path": "/tmp/katzensteg-vulkan-layers/katzensteg-gamescope-wsi-layer.json",
          "content": "{\n  \"file_format_version\": \"1.0.0\",\n  \"layer\": {\n    \"name\": \"VK_LAYER_FROG_gamescope_wsi_x86_64\",\n    \"type\": \"GLOBAL\",\n    \"api_version\": \"1.3.221\",\n    \"library_path\": \"$HOME/dev/gamescope/build-sdl/layer/libVkLayer_FROG_gamescope_wsi_x86_64.so\",\n    \"implementation_version\": \"1\",\n    \"description\": \"Gamescope WSI (XWayland Bypass) Layer (x86_64)\",\n    \"functions\": {\n      \"vkNegotiateLoaderLayerInterfaceVersion\": \"vkNegotiateLoaderLayerInterfaceVersion\"\n    },\n    \"enable_environment\": {\n      \"ENABLE_GAMESCOPE_WSI\": \"1\"\n    },\n    \"disable_environment\": {\n      \"DISABLE_GAMESCOPE_WSI\": \"1\"\n    }\n  }\n}\n"
        }
      ]
    },
    "probe.vulkan": {
      "extends": [
        "app.vulkan_probe",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "capture.vulkan"
      ],
      "runtime": {
        "vulkan_capture": true
      }
    },
    "probe.vulkan.sdl3": {
      "extends": [
        "app.vulkan_probe_sdl3",
        "adapter.sdl3_preload",
        "runtime.fullscreen_file",
        "capture.vulkan"
      ],
      "runtime": {
        "vulkan_capture": true
      }
    },
    "probe.gamescope": {
      "extends": [
        "app.gamescope",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "capture.vulkan"
      ]
    }
  }
}
