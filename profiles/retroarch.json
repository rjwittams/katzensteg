{
  "profiles": {
    "runtime.fullscreen_file": {
      "hidden": true,
      "runtime": {
        "composite_mode": "fullscreen",
        "intercept_mode": "queued_replay",
        "window_policy": "terminal_only",
        "input": true,
        "input_claim": true,
        "input_claim_focus": false,
        "output_profile": "file_whole"
      }
    },
    "capture.gl_pbo": {
      "hidden": true,
      "runtime": {
        "gl_capture": "pbo"
      }
    },
    "capture.vulkan": {
      "hidden": true,
      "runtime": {
        "vulkan_capture": true
      },
      "env": {
        "KATZENSTEG_VULKAN_CAPTURE": "1",
        "KATZENSTEG_CORE_LIB": {
          "linux": "{repo}/zig-out/lib/libkatzensteg-core.so",
          "macos": "{repo}/zig-out/lib/libkatzensteg-core.dylib"
        },
        "VK_LAYER_PATH": {
          "linux": "{repo}/profiles/vulkan/linux",
          "macos": "{repo}/profiles/vulkan/macos"
        },
        "VK_INSTANCE_LAYERS": "VK_LAYER_KATZENSTEG_capture",
        "KATZENSTEG_VULKAN_LOADER": {
          "macos": "/opt/homebrew/lib/libvulkan.1.dylib"
        }
      }
    },
    "config.retroarch_sdl2": {
      "hidden": true,
      "seed_files": [
        {
          "path": "/tmp/retroarch-sdl2.cfg",
          "content": "video_driver = \"sdl2\"\ninput_driver = \"sdl2\"\njoypad_driver = \"sdl2\"\npause_nonactive = \"false\"\n"
        }
      ]
    },
    "config.retroarch_input": {
      "hidden": true,
      "seed_files": [
        {
          "path": "/tmp/retroarch-input.cfg",
          "content": "input_driver = \"sdl2\"\njoypad_driver = \"sdl2\"\npause_nonactive = \"false\"\n"
        }
      ]
    },
    "config.retroarch_vulkan": {
      "hidden": true,
      "seed_files": [
        {
          "path": "/tmp/retroarch-sdl2-vulkan.cfg",
          "content": "video_driver = \"vulkan\"\nvideo_context_driver = \"sdl_vk\"\ninput_driver = \"sdl2\"\njoypad_driver = \"sdl2\"\npause_nonactive = \"false\"\nlog_verbosity = \"true\"\n"
        }
      ]
    },
    "adapter.sdl2_preload": {
      "hidden": true,
      "env": {
        "DYLD_INSERT_LIBRARIES": "{repo}/zig-out/lib/libkatzensteg-sdl2.dylib",
        "LD_PRELOAD": "{repo}/zig-out/lib/libkatzensteg-sdl2.so"
      }
    },
    "retroarch": {
      "target": "$HOME/dev/RetroArch/retroarch",
      "env": {
        "RETROARCH_COCOA_BOOTSTRAP_WINDOW": "0"
      }
    },
    "retroarch.app": {
      "hidden": true,
      "target": "$HOME/dev/RetroArch/RetroArch.app/Contents/MacOS/RetroArch",
      "env": {
        "RETROARCH_COCOA_BOOTSTRAP_WINDOW": "0"
      }
    },
    "sonic": {
      "extends": [
        "retroarch",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "config.retroarch_sdl2"
      ],
      "args": [
        "-L",
        "genesis_plus_gx_libretro",
        "-c",
        "/tmp/retroarch-sdl2.cfg",
        "$HOME/roms/sonic.md"
      ]
    },
    "mmx": {
      "extends": [
        "retroarch",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "config.retroarch_sdl2"
      ],
      "args": [
        "-L",
        "snes9x_libretro",
        "-c",
        "/tmp/retroarch-sdl2.cfg",
        "$HOME/roms/mmx.sfc"
      ]
    },
    "rrds": {
      "extends": [
        "retroarch",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "config.retroarch_sdl2",
        "capture.gl_pbo"
      ],
      "args": [
        "-L",
        "melonds_libretro",
        "-c",
        "/tmp/retroarch-sdl2.cfg",
        "$HOME/roms/rrds.nds"
      ]
    },
    "jsr": {
      "extends": [
        "retroarch",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "config.retroarch_vulkan",
        "capture.vulkan"
      ],
      "args": [
        "-L",
        "flycast_libretro",
        "-c",
        "/tmp/retroarch-sdl2-vulkan.cfg",
        "$HOME/roms/jgr/jgr.cue"
      ]
    },
    "spyro": {
      "extends": [
        "retroarch",
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "config.retroarch_vulkan",
        "capture.vulkan"
      ],
      "args": [
        "-L",
        "mednafen_psx_hw_libretro",
        "-c",
        "/tmp/retroarch-sdl2-vulkan.cfg",
        "$HOME/roms/spyro/spyro.cue"
      ]
    }
  }
}
