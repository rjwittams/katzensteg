{
  "profiles": {
    "steam.tempest_rising": {
      "target": "$HOME/dev/gamescope/build-sdl/src/gamescope",
      "args": [
        "--backend",
        "sdl",
        "-W",
        "1280",
        "-H",
        "720",
        "-w",
        "1280",
        "-h",
        "720",
        "--steam",
        "--virtual-connector-strategy",
        "SingleApplication",
        "--",
        "/usr/bin/env",
        "-u",
        "LD_PRELOAD",
        "-u",
        "DYLD_INSERT_LIBRARIES",
        "-u",
        "KATZENSTEG_CONFIG",
        "-u",
        "KATZENSTEG_CORE_LIB",
        "-u",
        "KATZENSTEG_VULKAN_CAPTURE",
        "-u",
        "KATZENSTEG_VULKAN_LOADER",
        "-u",
        "KATZENSTEG_TRACE_VULKAN",
        "-u",
        "KATZENSTEG_TRACE_SDL",
        "-u",
        "VK_INSTANCE_LAYERS",
        "VK_LAYER_PATH=/tmp/katzensteg-vulkan-layers",
        "$HOME/.local/share/Steam/steamapps/common/SteamLinuxRuntime_4/_v2-entry-point",
        "--verb=waitforexitandrun",
        "--",
        "$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/proton",
        "waitforexitandrun",
        "$HOME/.local/share/Steam/steamapps/common/Tempest Rising/Tempest/Binaries/Win64/Tempest-Win64-Shipping.exe"
      ],
      "env": {
        "PATH": "$HOME/dev/gamescope/build-sdl/src:$PATH",
        "STEAM_COMPAT_CLIENT_INSTALL_PATH": "$HOME/.local/share/Steam",
        "STEAM_COMPAT_DATA_PATH": "$HOME/.local/share/Steam/steamapps/compatdata/1486920",
        "SteamAppId": "1486920",
        "SteamGameId": "1486920",
        "ENABLE_GAMESCOPE_WSI": "1",
        "VK_LAYER_PATH": {
          "linux": "{repo}/profiles/vulkan/linux:/tmp/katzensteg-vulkan-layers",
          "macos": "{repo}/profiles/vulkan/macos:/tmp/katzensteg-vulkan-layers"
        },
        "KATZENSTEG_TRACE_VULKAN": "1",
        "KATZENSTEG_TRACE_SDL": "1"
      },
      "seed_files": [
        {
          "path": "/tmp/katzensteg-vulkan-layers/katzensteg-gamescope-wsi-layer.json",
          "content": "{\n  \"file_format_version\": \"1.0.0\",\n  \"layer\": {\n    \"name\": \"VK_LAYER_FROG_gamescope_wsi_x86_64\",\n    \"type\": \"GLOBAL\",\n    \"api_version\": \"1.3.221\",\n    \"library_path\": \"$HOME/dev/gamescope/build-sdl/layer/libVkLayer_FROG_gamescope_wsi_x86_64.so\",\n    \"implementation_version\": \"1\",\n    \"description\": \"Gamescope WSI (XWayland Bypass) Layer (x86_64)\",\n    \"functions\": {\n      \"vkNegotiateLoaderLayerInterfaceVersion\": \"vkNegotiateLoaderLayerInterfaceVersion\"\n    },\n    \"enable_environment\": {\n      \"ENABLE_GAMESCOPE_WSI\": \"1\"\n    },\n    \"disable_environment\": {\n      \"DISABLE_GAMESCOPE_WSI\": \"1\"\n    }\n  }\n}\n"
        }
      ],
      "extends": [
        "adapter.sdl2_preload",
        "runtime.fullscreen_file",
        "capture.vulkan"
      ],
      "runtime": {
        "real_window": "show"
      }
    },
