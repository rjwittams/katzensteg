{
  "profiles": {
    "runtime.terminal_only": {
      "hidden": true,
      "runtime": {
        "window_policy": "terminal_only",
        "input": true,
        "input_claim": true,
        "output_profile": "file_whole"
      }
    },
    "app.env": {
      "hidden": true,
      "target": "/usr/bin/env",
      "stdout": "/tmp/katzensteg-example.out",
      "stderr": "stdout"
    },
    "example": {
      "extends": [
        "app.env",
        "runtime.terminal_only"
      ],
      "args": [
        "KATZENSTEG_EXAMPLE=1"
      ],
      "env": {
        "KATZENSTEG_INPUT": "1"
      }
    }
  }
}
